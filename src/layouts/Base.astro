---
import '../styles/global.css';
import { phases } from '../data/phases.js';
const { title, description = "A free, plain-English computer science course for people who build apps with AI tools like Lovable, Cursor and Claude." } = Astro.props;
const site = "Computer Science for Vibe Coders";
const full = title ? `${title} | ${site}` : `${site}: Learn the fundamentals behind AI-built apps`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ...phases.map(p => ({ href: `/${p.slug}`, label: `0${p.num}` , title: p.title })),
  { href: '/shipping', label: 'ship' },
  { href: '/rules', label: 'rules' },
  { href: '/prompt', label: 'coach' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#0d1117" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site} />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={full} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Course","name":site,"description":description,"isAccessibleForFree":true,"url":Astro.site?.toString(),"provider":{"@type":"Person","name":"Johnder Perez"}})} />
<script is:inline>try{var t=localStorage.getItem('csvc-theme');if(t)document.documentElement.dataset.theme=t;}catch(e){}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap bar">
    <a href="/" class="brand"><span class="prompt" aria-hidden="true">~$</span> cs4vibecoders<span class="cursor" aria-hidden="true">▍</span></a>
    <nav aria-label="Main">
      <ul>
        {nav.map(n => <li><a href={n.href} title={n.title} aria-current={path === n.href ? 'page' : undefined}>{n.title ? <><span class="sr">Phase </span>{n.label}</> : n.label}</a></li>)}
        <li><button id="theme" class="themebtn" type="button" aria-label="Toggle light or dark theme"><span aria-hidden="true">◐</span></button></li>
      </ul>
    </nav>
  </div>
</header>
<main id="main" class="wrap"><slot /></main>
<footer class="foot">
  <div class="wrap">
    <p><span class="dim">//</span> A free side project by Johnder Perez. Share it with anyone who builds with AI.</p>
    <p class="muted">Book and course links go to their official sites. Nothing here is sponsored. <span class="egg-hint" title="psst: ↑ ↑ ↓ ↓ ← → ← → b a">exit 0</span></p>
  </div>
</footer>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme');
  const cur = () => root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  const label = () => btn.setAttribute('aria-pressed', String(cur() === 'light'));
  label();
  btn.addEventListener('click', () => { const n = cur() === 'light' ? 'dark' : 'light'; root.dataset.theme = n; try { localStorage.setItem('csvc-theme', n); } catch {} label(); });
  // Checklists: saved per list in localStorage, with a progress counter
  document.querySelectorAll('.checks').forEach(list => {
    const key = 'csvc-' + list.dataset.key;
    const boxes = [...list.querySelectorAll('input')];
    const out = document.querySelector(`[data-progress="${list.dataset.key}"]`);
    const upd = () => { if (out) { const n = boxes.filter(b => b.checked).length; out.textContent = `[${'#'.repeat(n)}${'.'.repeat(boxes.length - n)}] ${n}/${boxes.length}` + (n === boxes.length ? ' ✓ all done, nice' : ''); } };
    let saved = []; try { saved = JSON.parse(localStorage.getItem(key) || '[]'); } catch {}
    boxes.forEach((box, i) => { box.checked = !!saved[i]; box.addEventListener('change', () => { try { localStorage.setItem(key, JSON.stringify(boxes.map(b => b.checked))); } catch {} upd(); }); });
    upd();
  });
  // Easter eggs
  console.log('%c> hello, curious one.\n> you opened DevTools. that is literally Phase 1 energy.\n> try the Konami code on the page.', 'color:#39d353;font-family:monospace;font-size:13px');
  const toast = document.getElementById('toast');
  const say = (m) => { toast.textContent = m; toast.classList.add('on'); setTimeout(() => toast.classList.remove('on'), 3200); };
  const code = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a']; let i = 0;
  addEventListener('keydown', e => { i = (e.key === code[i]) ? i + 1 : (e.key === code[0] ? 1 : 0); if (i === code.length) { i = 0; root.classList.toggle('crt'); say(root.classList.contains('crt') ? '🕹️ CRT mode unlocked. sudo make me a sandwich.' : 'CRT mode off. Back to work.'); } });
  document.querySelector('.cursor')?.addEventListener('dblclick', e => { e.preventDefault(); say('segfault (core dumped). jk. keep learning ✨'); });
</script>
</body>
</html>
