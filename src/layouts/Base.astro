---
import '../styles/global.css';
import { phases } from '../data/phases.js';
const { title, description = "A free, plain-English computer science course for people who build apps with AI tools like Lovable, Cursor and Claude." } = Astro.props;
const site = "Computer Science for Vibe Coders";
const full = title ? `${title} | ${site}` : `${site}: Learn the fundamentals behind AI-built apps`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ...phases.map(p => ({ href: `/${p.slug}`, label: p.name })),
  { href: '/shipping', label: 'Shipping' },
  { href: '/rules', label: 'Rules' },
  { href: '/prompt', label: 'CS Coach' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#0f172a" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site} />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={full} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Course","name":site,"description":description,"isAccessibleForFree":true,"url":Astro.site?.toString(),"provider":{"@type":"Person","name":"Johnder Perez"}})} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap bar">
    <a href="/" class="brand"><span class="logo" aria-hidden="true">&lt;/&gt;</span> CS for Vibe Coders</a>
    <nav aria-label="Main">
      <ul>
        {nav.map(n => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
<main id="main" class="wrap"><slot /></main>
<footer class="foot">
  <div class="wrap">
    <p>A free side project by Johnder Perez. Share it with anyone who builds with AI.</p>
    <p class="muted">Book and course links go to their official sites. Nothing here is sponsored.</p>
  </div>
</footer>
<script>
  const get = k => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch { return null; } };
  const set = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };
  // Checklists (saved per list) with a progress count
  document.querySelectorAll('.checks').forEach(list => {
    const key = 'csvc-' + list.dataset.key, boxes = [...list.querySelectorAll('input')];
    const out = document.querySelector(`[data-progress="${list.dataset.key}"]`);
    const upd = () => { if (out) out.textContent = `${boxes.filter(b => b.checked).length} of ${boxes.length} done.`; };
    const saved = get(key) || [];
    boxes.forEach((b, i) => { b.checked = !!saved[i]; b.addEventListener('change', () => { set(key, boxes.map(x => x.checked)); upd(); }); });
    upd();
  });
  // Quizzes: one try, then reveal the answer and explanation
  document.querySelectorAll('.quiz').forEach(q => {
    const a = +q.dataset.answer, fb = q.querySelector('.feedback'), ex = q.querySelector('.explain');
    const step = document.querySelector('[data-step]')?.dataset.step;
    q.querySelectorAll('.opt').forEach(b => b.addEventListener('click', () => {
      const ok = +b.dataset.i === a;
      q.querySelectorAll('.opt').forEach(o => { o.disabled = true; if (+o.dataset.i === a) o.classList.add('right'); });
      if (!ok) b.classList.add('wrong');
      fb.textContent = ok ? 'Correct!' : 'Not quite. The right answer is highlighted.';
      ex.hidden = false;
      if (step) { const d = get('csvc-steps') || {}; d[step] = true; set('csvc-steps', d); }
    }));
  });
  // Mark completed steps on track pages
  const done = get('csvc-steps') || {};
  document.querySelectorAll('[data-done]').forEach(el => { if (done[el.dataset.done]) el.textContent = '✓ Done'; });
  // Big-O game
  document.querySelectorAll('.bigo').forEach(g => {
    let score = 0; const sc = g.querySelector('.score');
    g.querySelectorAll('.bigo-row').forEach(r => r.querySelectorAll('.opt').forEach(b => b.addEventListener('click', () => {
      const ok = b.dataset.v === r.dataset.a;
      r.querySelectorAll('.opt').forEach(o => { o.disabled = true; if (o.dataset.v === r.dataset.a) o.classList.add('right'); });
      if (ok) sc.textContent = ++score; else b.classList.add('wrong');
      r.querySelector('.feedback').textContent = ok ? 'Correct!' : `It's ${r.dataset.a}.`;
    })));
  });
  // Spot the bug
  document.querySelectorAll('.bug').forEach(g => {
    const bad = +g.dataset.bad;
    g.querySelectorAll('.line').forEach(b => b.addEventListener('click', () => {
      const ok = +b.dataset.i === bad;
      b.classList.add(ok ? 'right' : 'wrong');
      g.querySelector('.feedback').textContent = ok ? 'You found it!' : 'Not that line. Try again.';
      if (ok) { g.querySelectorAll('.line').forEach(l => l.disabled = true); g.querySelector('.explain').hidden = false; }
    }));
  });
  // Put-in-order challenge
  document.querySelectorAll('.order').forEach(g => {
    const picked = g.querySelector('.picked'), fb = g.querySelector('.feedback'), btns = [...g.querySelectorAll('.opts .opt')];
    let seq = [];
    btns.forEach(b => b.addEventListener('click', () => {
      seq.push(+b.dataset.i); b.disabled = true;
      const li = document.createElement('li'); li.textContent = b.textContent; picked.appendChild(li);
      if (seq.length === btns.length) fb.textContent = seq.every((v, i) => v === i) ? 'Perfect order. That is the safe way to ship.' : 'Not quite. Hit Reset and try again (hint: branch first, deploy last).';
    }));
    g.querySelector('.reset').addEventListener('click', () => { seq = []; picked.innerHTML = ''; fb.textContent = ''; btns.forEach(b => b.disabled = false); });
  });
</script>
</body>
</html>
