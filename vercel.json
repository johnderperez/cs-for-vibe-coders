{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/computer-science-for-vibe-coders/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/computer-science-for-vibe-coders",
      "permanent": false
    },
    {
      "source": "/computer-science-for-vibe-coders/phase-1-machine",
      "destination": "/computer-science-for-vibe-coders/how-computers-work",
      "permanent": true
    },
    {
      "source": "/computer-science-for-vibe-coders/phase-2-algorithms",
      "destination": "/computer-science-for-vibe-coders/algorithms-and-data",
      "permanent": true
    },
    {
      "source": "/computer-science-for-vibe-coders/phase-3-engineering",
      "destination": "/computer-science-for-vibe-coders/code-that-lasts",
      "permanent": true
    },
    {
      "source": "/computer-science-for-vibe-coders/phase-4-systems",
      "destination": "/computer-science-for-vibe-coders/building-for-scale",
      "permanent": true
    },
    {
      "source": "/:path((?!computer-science-for-vibe-coders).+)",
      "destination": "/computer-science-for-vibe-coders/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/computer-science-for-vibe-coders",
      "destination": "/index.html"
    },
    {
      "source": "/computer-science-for-vibe-coders/",
      "destination": "/index.html"
    },
    {
      "source": "/computer-science-for-vibe-coders/:path+",
      "destination": "/:path+"
    }
  ]
}