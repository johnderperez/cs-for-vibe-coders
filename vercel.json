{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/phase-1-machine",
      "destination": "/how-computers-work",
      "permanent": true
    },
    {
      "source": "/phase-2-algorithms",
      "destination": "/algorithms-and-data",
      "permanent": true
    },
    {
      "source": "/phase-3-engineering",
      "destination": "/code-that-lasts",
      "permanent": true
    },
    {
      "source": "/phase-4-systems",
      "destination": "/building-for-scale",
      "permanent": true
    }
  ]
}